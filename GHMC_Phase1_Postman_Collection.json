{
  "info": {
    "_postman_id": "ghmc-phase1-collection-id",
    "name": "GHMC Civic Portal - Phase 1 API Collection",
    "description": "Postman Collection for testing Multi-Tenancy, Dual Auth (JWT vs Sessions), and RBAC on the GHMC Municipal Portal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Zones & Tenants",
      "item": [
        {
          "name": "Get All GHMC Zones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/zones",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "zones"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication (JWT vs Sessions)",
      "item": [
        {
          "name": "Citizen Register (JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Anand Kumar\",\n  \"email\": \"anand.citizen@gmail.com\",\n  \"password\": \"ghmc123\",\n  \"phone\": \"+91-9988112233\",\n  \"zoneCode\": \"KHAIRATABAD\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/citizen/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "citizen", "register"]
            }
          }
        },
        {
          "name": "Citizen Login (Returns JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('jwt_token', jsonData.token);",
                  "    console.log('JWT Token set successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen.ravi@gmail.com\",\n  \"password\": \"ghmc123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/citizen/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "citizen", "login"]
            }
          }
        },
        {
          "name": "Official Login (Sets HTTP-Only JSESSIONID Cookie)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"inspector.khairatabad@ghmc.gov.in\",\n  \"password\": \"ghmc123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/official/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "official", "login"]
            }
          }
        },
        {
          "name": "Official Logout (Destroys Session)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/official/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "official", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Multi-Tenant Grievance Operations",
      "item": [
        {
          "name": "Submit Grievance (Citizen JWT + Zone Header)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Zone-Id", "value": "KHAIRATABAD" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Waterlogging near Metro Station\",\n  \"category\": \"DRAINAGE\",\n  \"description\": \"Water accumulation causing severe traffic blockage during rains.\",\n  \"location\": \"Khairatabad Metro Station Exit 2\",\n  \"wardNo\": \"Ward 91\",\n  \"zoneCode\": \"KHAIRATABAD\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/grievances",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "grievances"]
            }
          }
        },
        {
          "name": "Fetch Grievances (Khairatabad Zone Tenant)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Zone-Id", "value": "KHAIRATABAD" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/grievances",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "grievances"]
            }
          }
        },
        {
          "name": "Fetch Grievances (Secunderabad Zone Tenant)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Zone-Id", "value": "SECUNDERABAD" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/grievances",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "grievances"]
            }
          }
        },
        {
          "name": "Update Grievance Status (Protected by RBAC: Ward Inspector)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Zone-Id", "value": "KHAIRATABAD" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/grievances/grv-101/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "grievances", "grv-101", "status"]
            }
          }
        }
      ]
    }
  ]
}
