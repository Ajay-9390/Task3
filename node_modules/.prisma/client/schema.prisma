// Prisma Schema for GHMC Governance Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Zone {
  id         String      @id
  code       String      @unique
  name       String
  district   String
  status     String      @default("ACTIVE")
  users      User[]
  grievances Grievance[]

  @@map("zones")
}

model User {
  id           String      @id
  email        String      @unique
  password     String
  fullName     String
  phone        String?
  role         String // ROLE_MUNICIPAL_COMMISSIONER | ROLE_ZONAL_COMMISSIONER | ROLE_WARD_INSPECTOR | ROLE_CITIZEN
  zoneId       String
  zone         Zone        @relation(fields: [zoneId], references: [id])
  assignedWard String?
  grievances   Grievance[]

  @@map("users")
}

model Grievance {
  id          String   @id
  title       String
  category    String
  description String
  status      String   @default("SUBMITTED") // SUBMITTED | IN_PROGRESS | RESOLVED | REJECTED | CLOSED
  location    String
  wardNo      String
  citizenId   String
  citizen     User     @relation(fields: [citizenId], references: [id])
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id])
  createdAt   DateTime @default(now())

  @@map("grievances")
}

model Notification {
  id             String   @id
  recipientRole  String?
  recipientEmail String?
  zoneCode       String?
  title          String
  message        String
  type           String?
  grievanceId    String?
  createdAt      DateTime @default(now())
  readStatus     Boolean  @default(false)

  @@map("notifications")
}
